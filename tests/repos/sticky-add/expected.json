{
  "description": "A branch creation by copy and new files inside it in the SAME revision (copied root listed first) must be recognized as a creation and parented to the copy-from source (trunk at r4), not to the previously active branch (plain at r3) nor treated as a modification.",
  "config": {
    "keepDeletedBranches": false,
    "keepDeletedTags": false,
    "ignoredFolders": []
  },
  "log": { "info": 1, "warning": 0 },
  "refs": {
    "trunk": {
      "trailer_branch": "trunk",
      "commits": [
        [1, "r1: init trunk", null, { "a.txt": "A1", "b.txt": "B1" }],
        [4, "r4: update a", [["trunk", 1]], { "a.txt": "A2", "b.txt": "B1" }],
        [6, "r6: update b", [["trunk", 4]], { "a.txt": "A2", "b.txt": "B2" }]
      ]
    },
    "plain": {
      "trailer_branch": "plain",
      "commits": [
        [3, "r3: create plain branch", [["trunk", 1]], { "seed.txt": "seed" }]
      ]
    },
    "feature": {
      "trailer_branch": "feature",
      "commits": [
        [5, "r5: create feature branch from trunk", [["trunk", 4]], { "a.txt": "A2", "b.txt": "B1", "x1.txt": "X1", "x2.txt": "X2" }],
        [7, "r7: add x3 to feature", [["feature", 5]], { "a.txt": "A2", "b.txt": "B1", "x1.txt": "X1", "x2.txt": "X2", "x3.txt": "X3" }]
      ]
    }
  },
  "tags": []
}
